generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // IMPORTANT: Remember to hash passwords in your application code!
  date      DateTime @default(now())

  blogs     Blog[]
  images    Image[]
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String   // This should now be a URL string
  date        DateTime @default(now()) @map("createdAt") // REMOVE @index FROM THIS LINE

  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  @@index([date]) // ADD THIS LINE HERE, AT THE MODEL LEVEL, FOR THE INDEX
}

model Image {
  id       Int    @id @default(autoincrement())
  image    String

  user     User   @relation(fields: [userId], references: [id])
  userId   Int
}